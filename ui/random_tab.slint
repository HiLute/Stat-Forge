import { Palette } from "theme.slint";
import { AccentButton } from "widgets.slint";
import { RollCard, RollData } from "roll_card.slint";

export global RandomState {
    in property <[RollData]> rolls;
    in property <int> grand-total;
    callback roll();
    callback assign(card: int, option: int);
}

export component RandomTab inherits VerticalLayout {
    in property <int> columns;

    spacing: 14px;

    HorizontalLayout {
        spacing: 8px;
        Text {
            text: "Распределите результаты по характеристикам.";
            color: Palette.muted;
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: "Общая сумма: \{RandomState.grand-total}";
            color: Palette.accent;
            font-size: 14px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        AccentButton {
            text: "Бросок";
            clicked => {
                RandomState.roll();
            }
        }
    }

    for r in RandomState.rolls.length / root.columns: HorizontalLayout {
        spacing: 14px;
        for c in root.columns: RollCard {
            data: RandomState.rolls[r * root.columns + c];
            picked(option) => {
                RandomState.assign(r * root.columns + c, option);
            }
        }
    }
}
